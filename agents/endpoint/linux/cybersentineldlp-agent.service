[Unit]
Description=CyberSentinel DLP - Linux Endpoint Agent
Documentation=https://github.com/effaaykhan/cybersentineldlp-prod
# The agent registers with the manager and syncs policies over the network, so
# wait for a routable address rather than just for the network stack to exist.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is required, not cosmetic: process suspension/termination (SIGSTOP /
# SIGKILL on transfer tools), USB device controls, and inotify watches across
# other users' home directories all need it. Running unprivileged degrades the
# agent to detect-and-alert only.
User=root
Group=root

WorkingDirectory=__INSTALL_DIR__

# The agent is a single self-contained executable: the Python runtime, requests,
# watchdog, agent.py, policy_cache.py and print_monitor.py are all inside it.
# There is no interpreter or virtualenv path to reference, which is what makes
# this unit byte-identical on every endpoint in the fleet.
#
# A onefile binary unpacks itself into __RUN_DIR__ on each start and removes
# that copy on clean exit. A SIGKILL — or the crash Restart=always exists to
# handle — leaves it behind, so sweep stale copies rather than letting them
# accumulate one restart at a time.
ExecStartPre=-/bin/sh -c 'rm -rf __RUN_DIR__/_MEI*'
ExecStart=__BIN_PATH__ --config __CONFIG_FILE__

Environment=PYTHONUNBUFFERED=1
Environment=CYBERSENTINEL_LOG_FILE=__LOG_DIR__/agent.log
Environment=CYBERSENTINEL_LOG_LEVEL=INFO

# The agent installs SIGTERM/SIGINT handlers and unwinds its observers, netlink
# socket and worker threads in stop(). Give that a real chance before SIGKILL.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30

Restart=always
RestartSec=10
# A security agent should keep trying rather than latch into 'failed' after a
# few bad starts (e.g. manager unreachable during a reboot). RestartSec already
# bounds this to ~6 attempts/minute.
StartLimitIntervalSec=0

# One inotify watch per monitored directory plus open file handles during
# content inspection; the default 1024 is easily exhausted on a busy endpoint.
LimitNOFILE=65535

# Don't let the OOM killer pick the DLP agent first.
OOMScoreAdjust=-500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cybersentineldlp-agent

# NOTE: deliberately not sandboxed with ProtectSystem/ProtectHome/PrivateTmp.
# A DLP agent must read arbitrary files anywhere on the box, move them into
# quarantine, and signal other users' processes. Those directives would break
# core functionality rather than harden it.

[Install]
WantedBy=multi-user.target
