#!/usr/bin/env bash
#
# csdlp — CyberSentinel DLP single operations CLI.
#
# One tool to operate, debug, update and roll back a deployed stack. Wraps
# `docker compose` with safe update/rollback, backups, diagnostics and log
# access. Install to /usr/local/bin/csdlp (see `csdlp self-install`).
#
#   csdlp status                 health of every service + versions
#   csdlp doctor [--bundle]      full diagnostics (secrets redacted); --bundle -> tarball
#   csdlp logs [service] [-f]    tail/follow logs (all services, or one)
#   csdlp update [IMAGE_TAG]     backup -> pull -> migrate -> up -> health-gate -> auto-rollback
#   csdlp check-updates          what upstream versions are newer than the pins
#   csdlp upgrade-postgres       Postgres MAJOR upgrade (dump -> new volume -> restore)
#   csdlp upgrade-mongo          MongoDB MAJOR upgrade (FCV step -> swap -> FCV step)
#   csdlp rollback               revert to the image versions from before the last update
#   csdlp backup                 snapshot postgres + mongo to ./backups/<ts>/
#   csdlp restore <dir>          restore postgres + mongo from a backup dir
#   csdlp migrate                run DB migrations (alembic upgrade head)
#   csdlp restart [service]      restart one service or the whole stack
#   csdlp ps                     docker compose ps
#   csdlp secret admin-password  print the first-boot admin password (from manager logs)
#   csdlp sso-cert <sub>         point SSO at the SIEM and trust its TLS certificate
#   csdlp version                image tags/digests + API version
#   csdlp self-update            fetch the newest csdlp + compose from the repo
#   csdlp self-install           copy this script to /usr/local/bin/csdlp
#
set -uo pipefail

# ─── locate the deployment (dir with the prod compose file + .env) ────────
CSDLP_DIR="${CSDLP_DIR:-}"
_find_dir() {
    for d in "$CSDLP_DIR" "$PWD" /opt/cybersentineldlp /srv/cybersentineldlp; do
        [ -n "$d" ] || continue
        for f in docker-compose.prod.yml docker-compose.yml docker-compose.deploy.yml; do
            [ -f "$d/$f" ] && { echo "$d|$f"; return 0; }
        done
    done
    return 1
}
_loc="$(_find_dir)" || { echo "csdlp: no docker-compose file found (set CSDLP_DIR)" >&2; exit 1; }
DIR="${_loc%%|*}"; COMPOSE="${_loc##*|}"
# CSDLP_COMPOSE forces a specific compose file (e.g. the base file on a dev box).
[ -n "${CSDLP_COMPOSE:-}" ] && [ -f "$DIR/${CSDLP_COMPOSE}" ] && COMPOSE="${CSDLP_COMPOSE}"
cd "$DIR" || exit 1
ENVF="$DIR/.env"

# ─── ui ───────────────────────────────────────────────────────────────────
if [ -t 1 ]; then C0=$'\033[0m'; CB=$'\033[1;34m'; CG=$'\033[1;32m'; CY=$'\033[1;33m'; CR=$'\033[1;31m'; CD=$'\033[2m'
else C0=; CB=; CG=; CY=; CR=; CD=; fi
hd()  { printf '%s== %s ==%s\n' "$CB" "$*" "$C0"; }
ok()  { printf '  %s[ok]%s %s\n' "$CG" "$C0" "$*"; }
warn(){ printf '  %s[!!]%s %s\n' "$CY" "$C0" "$*"; }
err() { printf '  %s[xx]%s %s\n' "$CR" "$C0" "$*" >&2; }
kv()  { printf '  %-14s %s\n' "$1" "$2"; }

dc()  { docker compose -f "$COMPOSE" "$@"; }
# load a single key from .env without exposing the whole file
# LAST match, not first — the same rule docker compose applies.
#
# A duplicated key in .env is not an error to either tool, they just disagree
# about which line wins: compose takes the last, this took the first. On a
# deployment whose .env carried POSTGRES_USER twice, compose built the cluster
# as one role while csdlp dumped as another, so every backup failed with `role
# does not exist` and wrote a zero-byte file. Reading it the way compose reads
# it is the only way these two can agree about what is deployed.
envget() { [ -f "$ENVF" ] && sed -n "s/^$1=//p" "$ENVF" | tail -1 | tr -d '"'"'"' '; }
# Set KEY=VALUE in .env, replacing an existing line (commented or not) in place
# so its position and surrounding comments survive. Appends when absent.
envset() {
    local k="$1" v="$2"
    [ -f "$ENVF" ] || touch "$ENVF"
    if grep -qE "^[#[:space:]]*${k}=" "$ENVF"; then
        local tmp; tmp="$(mktemp)"
        awk -v k="$k" -v v="$v" '
            !done && $0 ~ "^[#[:space:]]*" k "=" { print k "=" v; done=1; next }
            { print }
        ' "$ENVF" > "$tmp" && cat "$tmp" > "$ENVF" && rm -f "$tmp"
    else
        printf '%s=%s\n' "$k" "$v" >> "$ENVF"
    fi
}
# run curl inside the manager container (works regardless of host port mapping)
mgr_curl() { dc exec -T manager curl -sk --max-time 8 "$@" 2>/dev/null; }

MANAGER_IMG="$(grep -oE 'ghcr\.io/[^ ]*dlp-manager[^ ]*' "$COMPOSE" | head -1)"
DASH_IMG="$(grep -oE 'ghcr\.io/[^ ]*dlp-dashboard[^ ]*' "$COMPOSE" | head -1)"
# Fallback for locally-built (dev) compose that uses build: instead of a ghcr
# image — read the actual image off the running container.
_running_img() { docker inspect "$(docker compose -f "$COMPOSE" ps -q "$1" 2>/dev/null | head -1)" --format '{{.Config.Image}}' 2>/dev/null; }
[ -z "$MANAGER_IMG" ] && MANAGER_IMG="$(_running_img manager)"
[ -z "$DASH_IMG" ] && DASH_IMG="$(_running_img dashboard)"

# ─── subcommands ──────────────────────────────────────────────────────────
cmd_status() {
    hd "CyberSentinel DLP — status"
    kv "dir" "$DIR"
    kv "compose" "$COMPOSE"
    local h; h="$(mgr_curl http://localhost:55100/health)"
    if [ -n "$h" ]; then
        kv "api" "$(printf '%s' "$h" | grep -oE '"status":"[^"]*"' | cut -d: -f2 | tr -d '"')"
        kv "version" "$(printf '%s' "$h" | grep -oE '"version":"[^"]*"' | cut -d: -f2 | tr -d '"')"
        printf '  %-14s %s\n' "checks" "$(printf '%s' "$h" | grep -oE '"checks":\{[^}]*\}')"
    else
        err "manager /health unreachable"
    fi
    echo
    dc ps
}

cmd_ps() { dc ps; }

cmd_logs() {
    local svc="" follow=""
    for a in "$@"; do case "$a" in -f|--follow) follow="-f";; *) svc="$a";; esac; done
    # shellcheck disable=SC2086
    dc logs --tail=200 $follow $svc
}

cmd_migrate() {
    hd "DB migrations (alembic upgrade head)"
    if dc exec -T manager sh -c 'command -v alembic >/dev/null 2>&1'; then
        dc exec -T manager alembic upgrade head && ok "migrations applied" || { err "migration failed"; return 1; }
    else
        warn "alembic not found in manager image — skipping (schema may rely on boot-time DDL)"
    fi
}

cmd_backup() {
    local ts dst; ts="$(date +%Y%m%d-%H%M%S)"; dst="$DIR/backups/$ts"
    mkdir -p "$dst"
    hd "Backup -> $dst"
    local pgu pgd; pgu="$(envget POSTGRES_USER)"; pgd="$(envget POSTGRES_DB)"
    pgu="${pgu:-dlp_user}"; pgd="${pgd:-cybersentineldlp}"
    local pgerr; pgerr="$(mktemp)"
    _pg_run pg_dump "$pgd" > "$dst/postgres.sql" 2>"$pgerr"
    if [ -s "$dst/postgres.sql" ]; then
        ok "postgres -> postgres.sql ($(wc -c < "$dst/postgres.sql") bytes)"
    else
        err "postgres dump FAILED (user=$pgu db=$pgd) — postgres.sql is empty"
        sed 's/^/        /' "$pgerr" | head -5 >&2
        err "tried user/db combinations:$(_pg_tried)"
        rm -f "$dst/postgres.sql"
    fi
    rm -f "$pgerr"
    local mu mp mgerr; mu="$(_mg_user)"; mp="$(_mg_pass)"; mgerr="$(mktemp)"
    dc exec -T mongodb sh -c "mongodump --quiet --username '$mu' --password '$mp' --authenticationDatabase admin --archive" > "$dst/mongo.archive" 2>"$mgerr"
    if [ -s "$dst/mongo.archive" ]; then
        ok "mongodb -> mongo.archive ($(wc -c < "$dst/mongo.archive") bytes)"
    else
        err "mongo dump FAILED (user=$mu) — mongo.archive is empty"
        sed 's/^/        /' "$mgerr" | head -5 >&2
        rm -f "$dst/mongo.archive"
    fi
    rm -f "$mgerr"

    # OpenSearch was missing from this entirely, and it is the one store here
    # that a version change cannot be rolled back out of: an index directory
    # opened by a newer major will not start on the old one. A "backup" that
    # covers two of the three datastores is the kind that is discovered to be
    # incomplete at the worst possible moment.
    #
    # Taken COLD - stopped, tarred, started. A hot tar of a live Lucene index
    # copies segments mid-merge and restores to something that may not open.
    # The stop costs search for as long as the tar takes; on this deployment
    # that is seconds, and `update` restarts the stack immediately after anyway.
    local osvol
    osvol="$(docker inspect "$(dc ps -q opensearch 2>/dev/null | head -1)" \
             --format '{{range .Mounts}}{{if eq .Destination "/usr/share/opensearch/data"}}{{.Name}}{{end}}{{end}}' 2>/dev/null)"
    if [ -n "$osvol" ] && docker volume inspect "$osvol" >/dev/null 2>&1; then
        dc stop opensearch >/dev/null 2>&1
        if docker run --rm -v "$osvol":/data -v "$dst":/b alpine \
               tar czf /b/opensearch.tgz -C /data . >/dev/null 2>&1 && [ -s "$dst/opensearch.tgz" ]; then
            ok "opensearch -> opensearch.tgz ($(wc -c < "$dst/opensearch.tgz") bytes)"
        else warn "opensearch snapshot failed/empty"; fi
        dc start opensearch >/dev/null 2>&1
    else
        warn "opensearch volume not found — snapshot skipped"
    fi
    echo "$dst"
}

cmd_restore() {
    local src="${1:-}"; [ -d "$src" ] || { err "usage: csdlp restore <backup-dir>"; return 1; }
    hd "Restore from $src"
    warn "This overwrites current data. Ctrl-C within 5s to abort."; sleep 5
    local pgu pgd; pgu="$(_pg_user)"; pgd="$(_pg_db)"
    [ -f "$src/postgres.sql" ] && { _pg_run psql -d "$pgd" < "$src/postgres.sql" >/dev/null 2>&1 && ok "postgres restored" || warn "postgres restore had errors"; }
    local mu mp; mu="$(_mg_user)"; mp="$(_mg_pass)"
    [ -f "$src/mongo.archive" ] && { dc exec -T mongodb sh -c "mongorestore --quiet --drop --username '$mu' --password '$mp' --authenticationDatabase admin --archive" < "$src/mongo.archive" >/dev/null 2>&1 && ok "mongo restored" || warn "mongo restore had errors"; }

    # Restoring OpenSearch means replacing the data directory wholesale, which
    # only works with the node down. Reverting a MAJOR also needs the image pin
    # put back by hand first — a 3.x directory is what is in this tarball only
    # if the tarball predates the upgrade.
    if [ -f "$src/opensearch.tgz" ]; then
        local osvol
        osvol="$(docker inspect "$(dc ps -q opensearch 2>/dev/null | head -1)" \
                 --format '{{range .Mounts}}{{if eq .Destination "/usr/share/opensearch/data"}}{{.Name}}{{end}}{{end}}' 2>/dev/null)"
        if [ -n "$osvol" ]; then
            dc stop opensearch >/dev/null 2>&1
            docker run --rm -v "$osvol":/data alpine sh -c 'rm -rf /data/* /data/..?* 2>/dev/null; true' >/dev/null 2>&1
            if docker run --rm -v "$osvol":/data -v "$src":/b alpine \
                   tar xzf /b/opensearch.tgz -C /data >/dev/null 2>&1; then
                ok "opensearch restored"
            else warn "opensearch restore had errors"; fi
            dc start opensearch >/dev/null 2>&1
        else warn "opensearch volume not found — skipped"; fi
    fi
}

_health_ok() {
    for _ in $(seq 1 30); do
        printf '%s' "$(mgr_curl http://localhost:55100/health)" | grep -q '"status":"healthy"' && return 0
        sleep 2
    done
    return 1
}

# Best DURABLE reference for an image, printed as "tag:<t>" or "id:<sha256:…>".
#
# A registry tag is strongly preferred: CI stamps every build with an immutable
# sha-<commit> tag, which can be re-pulled even if the local image was pruned or
# you are recovering on a host that never ran that version. The local image ID is
# only a fallback for dev/locally-built images that carry no CI provenance — it
# dies with a `docker image prune`, which is exactly how a rollback becomes
# unrecoverable.
_img_ref() {
    local img="$1" repo tag rev
    repo="${img%:*}"
    # 1. an immutable sha-* tag already present on the image
    tag="$(docker image inspect "$img" --format '{{range .RepoTags}}{{println .}}{{end}}' 2>/dev/null \
           | sed -n "s#^${repo}:\(sha-[0-9a-f]\{7,\}\)\$#\1#p" | head -1)"
    # 2. else derive it from the OCI revision label CI stamps on every build
    if [ -z "$tag" ]; then
        rev="$(docker image inspect "$img" \
               --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' 2>/dev/null)"
        case "$rev" in
            [0-9a-f][0-9a-f]*) tag="sha-$(printf '%s' "$rev" | cut -c1-7)";;
        esac
    fi
    [ -n "$tag" ] && { printf 'tag:%s' "$tag"; return 0; }
    # 3. no CI provenance — fall back to the local content ID
    docker image inspect "$img" --format 'id:{{.Id}}' 2>/dev/null
}

# Restore one image to a saved reference. Returns the reference actually used.
_restore_img() {
    local img="$1" ref="$2" repo t i
    repo="${img%:*}"
    case "$ref" in
        tag:*)
            t="${ref#tag:}"
            docker image inspect "$repo:$t" >/dev/null 2>&1 || docker pull "$repo:$t" >/dev/null 2>&1 || return 1
            docker tag "$repo:$t" "$img" || return 1
            printf '%s' "$repo:$t";;
        id:*)
            i="${ref#id:}"
            docker image inspect "$i" >/dev/null 2>&1 || return 1
            docker tag "$i" "$img" || return 1
            printf '%s' "$i";;
        *) return 1;;
    esac
}

_save_versions() {
    # record how to get back to the CURRENT images (registry tag if available,
    # local image ID otherwise) so rollback can restore them
    mkdir -p "$DIR/.csdlp"
    { printf 'manager %s\n' "$(_img_ref "$MANAGER_IMG")"
      [ -n "$DASH_IMG" ] && printf 'dashboard %s\n' "$(_img_ref "$DASH_IMG")"
    } > "$DIR/.csdlp/prev-versions"
}

# ─── upstream version checking ────────────────────────────────────────────
# Every backing service is pinned, which is what stops an unattended `pull`
# from moving a database major underneath a running stack. The cost is that
# nothing tells you a pin has gone stale. These functions do.
#
# The distinction that matters is same-major vs major:
#   * same-major (16.15 -> 16.17, 3.8.0 -> 3.8.4) is drop-in. Applied.
#   * a major (16 -> 18, 7.0 -> 8.0) rewrites the on-disk format and cannot be
#     undone by re-tagging. Reported, never applied by `update`.
# A floating tag (16-alpine, 7.0) is a prefix of its line's newest release, so
# `docker pull` already moves it - calling that "behind" would send an operator
# chasing an update they get for free.
_TAGCHECK_PY=$(cat <<'PYCHECK'
"""Newest upstream tag for an image, split into same-major and newer-major.

Prints: <current> <same_major_latest|-> <newer_major_latest|-> <state>
state: current | minor | major | unknown
"""
import json, re, sys, urllib.request

TAG_RE = re.compile(r'^(\d+(?:\.\d+)*)(-[a-z0-9.]+)?$')

def parse(tag):
    m = TAG_RE.match(tag)
    if not m:
        return None, None
    nums = tuple(int(x) for x in m.group(1).split('.'))
    return nums, (m.group(2) or '')

def fetch(repo):
    ns, _, name = repo.rpartition('/')
    ns = ns or 'library'
    tags, url = [], (f"https://hub.docker.com/v2/repositories/{ns}/{name}"
                     f"/tags/?page_size=100&ordering=last_updated")
    for _ in range(3):                       # 300 tags is plenty of history
        try:
            with urllib.request.urlopen(url, timeout=20) as r:
                d = json.load(r)
        except Exception:
            break
        tags += [t['name'] for t in d.get('results', [])]
        url = d.get('next')
        if not url:
            break
    return tags

def main():
    ref = sys.argv[1]
    repo, _, tag = ref.rpartition(':')
    if not repo:
        repo, tag = ref, 'latest'
    cur, suffix = parse(tag)
    if cur is None:
        print(f"{tag} - - - unknown")        # :latest and friends
        return

    # Three different questions, which a single "is it newer" conflates:
    #
    #  line   - a newer release of the exact line this tag names. The tag is a
    #           PREFIX of it (mongo:8.0 -> 8.0.30, postgres:16-alpine ->
    #           16.17-alpine), so `docker pull` already moves it and there is
    #           nothing for an operator to do.
    #  same   - same major, DIFFERENT line (mongo:8.0 -> 8.3.9). A pull will
    #           never fetch this; it takes a deliberate edit. For MongoDB it is
    #           also a rapid release rather than the LTS line, so calling it
    #           "safe to pull" was wrong twice over.
    #  major  - a new major. Rewrites on-disk format; never automatic.
    best_line = best_same = best_new = None
    for t in fetch(repo):
        n, s = parse(t)
        if n is None or s != suffix:
            continue
        if n[0] > cur[0]:
            if best_new is None or n > best_new[0]:
                best_new = (n, t)
        elif n[0] == cur[0]:
            on_line = n[:len(cur)] == cur and len(n) > len(cur)
            if on_line:
                if best_line is None or n > best_line[0]:
                    best_line = (n, t)
            elif n > cur:
                if best_same is None or n > best_same[0]:
                    best_same = (n, t)

    line = best_line[1] if best_line else '-'
    same = best_same[1] if best_same else '-'
    new  = best_new[1] if best_new else '-'
    if new != '-':
        state = 'major'
    elif line != '-':
        state = 'floating'
    elif same != '-':
        state = 'minor'
    else:
        state = 'current'
    print(f"{tag} {line} {same} {new} {state}")

main()
PYCHECK
)

# The image: line for one service. Scans the whole service block rather than a
# fixed window - a grep -A3 missed opensearch the moment a comment grew above
# its image line, and silently reported nothing for it.
_svc_image() {
    awk -v svc="$1" '
        $0 ~ "^  " svc ":[[:space:]]*$" { inblock = 1; next }
        inblock && /^  [a-zA-Z_-]+:[[:space:]]*$/ { exit }
        inblock && $1 == "image:" { print $2; exit }
    ' "$COMPOSE"
}

# Images this stack pins, as "service image".
_pinned_images() {
    local svc img
    for svc in opensearch postgres mongodb redis; do
        img="$(_svc_image "$svc")"
        [ -n "$img" ] && printf '%s %s\n' "$svc" "$img"
    done
}

# "<tag> <same_major> <newer_major> <state>" for one image ref, or "" if the
# lookup is impossible. A registry that is down must never fail an update.
_upstream_state() {
    command -v python3 >/dev/null 2>&1 || return 1
    printf '%s' "$_TAGCHECK_PY" | python3 - "$1" 2>/dev/null
}

# Report what is behind. Returns 0 if any MAJOR is pending, 1 otherwise, so
# callers can decide whether to nag.
_report_updates() {
    local svc img out cur same new state majors=0
    if ! command -v python3 >/dev/null 2>&1; then
        warn "python3 not found - skipping the upstream version check"
        return 1
    fi
    while read -r svc img; do
        [ -n "$img" ] || continue
        out="$(_upstream_state "$img")" || out=""
        if [ -z "$out" ]; then
            printf '    %-12s %-22s %s\n' "$svc" "${img##*:}" "lookup unavailable"
            continue
        fi
        read -r cur line same new state <<<"$out"
        case "$state" in
            current)  printf '    %-12s %-22s up to date\n' "$svc" "$cur";;
            floating) printf '    %-12s %-22s tracks %s - a pull moves it\n' "$svc" "$cur" "$line"
                      [ "$same" != "-" ] && printf '                 (%s also exists - different line, needs a deliberate edit)\n' "$same";;
            minor)    printf '    %-12s %-22s -> %s  same major, needs a deliberate edit\n' "$svc" "$cur" "$same";;
            major)    majors=$((majors + 1))
                      printf '    %-12s %-22s -> %s  %sMAJOR - not applied%s\n' "$svc" "$cur" "$new" "$CY" "$C0"
                      case "$svc" in
                          postgres) printf '                 run: csdlp upgrade-postgres\n';;
                          mongodb)  printf '                 run: csdlp upgrade-mongo\n';;
                          *)        printf '                 edit %s to move it deliberately\n' "$COMPOSE";;
                      esac;;
            *)        printf '    %-12s %-22s %s\n' "$svc" "$cur" "$state";;
        esac
    done <<<"$(_pinned_images)"
    [ "$majors" -gt 0 ]
}

cmd_check_updates() {
    hd "Upstream versions"
    local pending=0
    _report_updates && pending=1
    printf '    %-12s %-22s %s\n' "manager" "${MANAGER_IMG##*:}" "tracks the tag - a pull moves it"
    [ "$pending" = "1" ] && { echo; warn "major upgrades are available and were NOT applied"; }
    return 0
}

cmd_update() {
    local tag="${1:-}" pinf="$DIR/.csdlp/pinned"
    # A rollback pins the known-good tag. Without this guard the next bare
    # `csdlp update` runs `docker compose pull`, which fetches :latest from the
    # registry — i.e. the exact build just rolled away from — silently undoing
    # the recovery. Moving off a pin has to be deliberate.
    if [ -z "$tag" ] && [ -f "$pinf" ]; then
        err "pinned to $(cat "$pinf") by a previous rollback."
        err "use 'csdlp update <TAG>' for a specific build, or 'csdlp update latest' to release the pin."
        return 1
    fi
    # `update latest` is the explicit way back onto the moving tag.
    [ "$tag" = "latest" ] && { rm -f "$pinf"; tag=""; }
    hd "Update${tag:+ -> $tag}"
    _warn_dup_env || true
    # What is behind, before anything is touched. Same-major moves ride along
    # with the pull below; a major is reported and left alone, because it
    # rewrites an on-disk format and cannot be undone by re-tagging.
    echo "  checking upstream versions..."
    _report_updates && _majors_pending=1 || _majors_pending=0
    ok "1/5 snapshotting current versions + DB backup"
    _save_versions
    local _bdir; _bdir="$(cmd_backup | tail -1)"
    # An update proceeding on a backup that silently produced nothing is how a
    # recoverable bad night becomes an unrecoverable one. It is still not a hard
    # stop - a broken mongo must not block a manager fix - but it is said out
    # loud, once, where an operator will see it before the pull.
    if [ -n "$_bdir" ] && [ -d "$_bdir" ]; then
        local _missing=""
        [ -s "$_bdir/postgres.sql" ]   || _missing="$_missing postgres"
        [ -s "$_bdir/mongo.archive" ]  || _missing="$_missing mongo"
        [ -s "$_bdir/opensearch.tgz" ] || _missing="$_missing opensearch"
        [ -n "$_missing" ] && warn "BACKUP INCOMPLETE -${_missing} — continuing, but rollback will not cover${_missing}"
    else
        warn "BACKUP DID NOT RUN — continuing, but there is nothing to roll back to"
    fi
    if [ -n "$tag" ]; then
        # retag the pinned images to the requested tag by pulling that tag
        docker pull "${MANAGER_IMG%:*}:$tag" && docker tag "${MANAGER_IMG%:*}:$tag" "$MANAGER_IMG"
        [ -n "$DASH_IMG" ] && { docker pull "${DASH_IMG%:*}:$tag" && docker tag "${DASH_IMG%:*}:$tag" "$DASH_IMG"; }
    else
        ok "2/5 pulling latest images"; dc pull
    fi
    ok "3/5 starting services"; dc up -d
    # Recreating a backing service gives it a new IP, and the manager's existing
    # connection pool keeps dialling the old one - /health then reports
    # "redis: fail" against a redis that is perfectly healthy. `up -d` only
    # recreates containers whose own image changed, so a redis-only or
    # opensearch-only pull leaves a running manager holding dead sockets.
    # Restarting it here costs a few seconds and removes the whole failure mode.
    dc restart manager celery-worker celery-beat >/dev/null 2>&1
    ok "4/5 running migrations"; cmd_migrate || warn "migrate step reported issues"
    ok "5/5 health gate"
    if _health_ok; then
        rm -f "$pinf"          # deliberate move succeeded — release any pin
        if [ "${_majors_pending:-0}" = "1" ]; then
            ok "update healthy — major upgrades still pending (see above)"
        else
            ok "update healthy — done"
        fi
    else
        err "health check FAILED after update — rolling back"
        cmd_rollback
    fi
}

# Credentials for a running container, read from the container itself.
#
# envget() only sees .env, and a compose file is free to hardcode these instead
# - the dev compose does exactly that (POSTGRES_DB: cybersentinel_dlp). Taking
# the value from .env there yields the wrong database name, and a dump of the
# wrong database looks like a successful backup right up until the restore.
_svc_env() {
    dc exec -T "$1" printenv "$2" 2>/dev/null | tr -d '\r' | head -1
}
# Credentials are PROVED, not read.
#
# POSTGRES_USER and POSTGRES_DB are honoured by the official image only at
# initdb, on an empty volume. Edit .env afterwards and the file says one thing
# while the cluster contains another - and every dump then fails with `role
# "dlp_user" does not exist`, writes a zero-byte file, and reports success.
# That is how a deployment ends up holding a shelf of empty backups and finds
# out during a restore.
#
# So each candidate is tried against the server and the first one that actually
# authenticates wins. If none do, the declared value is returned so the error
# message names what was configured rather than something invented here.
# How to reach Postgres: which role, which database, over which transport.
#
# Three separate things went wrong here, each of which produced a zero-byte
# "backup" that reported success:
#
#  * .env can disagree with the cluster. POSTGRES_USER is honoured by the image
#    only at initdb on an empty volume, so an .env edited later describes a role
#    that was never created.
#  * psql defaults the DATABASE NAME TO THE USERNAME. Probing `psql -U dlp_user`
#    fails with `database "dlp_user" does not exist` even when the role is
#    perfectly fine - so a probe that does not name a database rejects the very
#    credentials it was meant to discover.
#  * the socket and TCP can carry different pg_hba rules, so a role the manager
#    authenticates with over the network can be refused on the socket.
#
# So: every user is tried against every candidate database, over both
# transports, and the first combination that answers wins. Each attempt is
# recorded, because "could not connect" with no list of what was tried is how
# this stayed unexplained through several rounds.
PG_USER=""; PG_DB=""; PG_HOSTARG=""; PG_PASS=""; PG_TRIED=""
_pg_resolve() {
    [ -n "$PG_USER" ] && return 0
    local u d pw users dbs seen
    pw="$(envget POSTGRES_PASSWORD)"; [ -n "$pw" ] || pw="$(_svc_env postgres POSTGRES_PASSWORD)"
    users="$(printf '%s\n%s\npostgres\ndlp_user\n' "$(envget POSTGRES_USER)" "$(_svc_env postgres POSTGRES_USER)" | awk 'NF && !a[$0]++')"
    dbs="$(printf '%s\n%s\npostgres\n' "$(envget POSTGRES_DB)" "$(_svc_env postgres POSTGRES_DB)" | awk 'NF && !a[$0]++')"
    for u in $users; do
        for d in $dbs $u; do
            [ -n "$d" ] || continue
            seen=" $u/$d"; case "$PG_TRIED" in *"$seen "*) continue;; esac
            PG_TRIED="$PG_TRIED$seen "
            if dc exec -T postgres psql -U "$u" -d "$d" -Atc 'SELECT 1' >/dev/null 2>&1; then
                PG_USER="$u"; PG_DB="$d"; PG_HOSTARG=""; PG_PASS=""; return 0
            fi
            if [ -n "$pw" ] && dc exec -T -e PGPASSWORD="$pw" postgres \
                   psql -U "$u" -h 127.0.0.1 -d "$d" -Atc 'SELECT 1' >/dev/null 2>&1; then
                PG_USER="$u"; PG_DB="$d"; PG_HOSTARG="-h 127.0.0.1"; PG_PASS="$pw"; return 0
            fi
        done
    done
    PG_USER="$(envget POSTGRES_USER)"; PG_DB="$(envget POSTGRES_DB)"; PG_HOSTARG=""; PG_PASS=""
    return 1
}
# Run a postgres client tool the way that actually works here.
_pg_run() { _pg_resolve || true; dc exec -T -e PGPASSWORD="$PG_PASS" postgres "$@" -U "$PG_USER" $PG_HOSTARG; }
_pg_user() { _pg_resolve || true; printf '%s' "$PG_USER"; }
_pg_db()   { _pg_resolve || true; printf '%s' "$PG_DB"; }
# What was tried, for an error message that can be acted on.
_pg_tried() { printf '%s' "${PG_TRIED:-nothing}"; }

_mg_ok() { dc exec -T mongodb mongosh --quiet -u "$1" -p "$2" --authenticationDatabase admin --eval 'db.adminCommand({ping:1}).ok' 2>/dev/null | tr -d '\r' | grep -q 1; }
_mg_user() {
    local u p
    u="$(envget MONGODB_USER)"; p="$(envget MONGODB_PASSWORD)"
    _mg_ok "$u" "$p" && { printf '%s' "$u"; return 0; }
    u="$(_svc_env mongodb MONGO_INITDB_ROOT_USERNAME)"; p="$(_svc_env mongodb MONGO_INITDB_ROOT_PASSWORD)"
    _mg_ok "$u" "$p" && { printf '%s' "$u"; return 0; }
    printf '%s' "$(envget MONGODB_USER)"
}
_mg_pass() {
    local u p
    u="$(envget MONGODB_USER)"; p="$(envget MONGODB_PASSWORD)"
    _mg_ok "$u" "$p" && { printf '%s' "$p"; return 0; }
    u="$(_svc_env mongodb MONGO_INITDB_ROOT_USERNAME)"; p="$(_svc_env mongodb MONGO_INITDB_ROOT_PASSWORD)"
    _mg_ok "$u" "$p" && { printf '%s' "$p"; return 0; }
    printf '%s' "$(envget MONGODB_PASSWORD)"
}

# ─── major database upgrades ──────────────────────────────────────────────
# Kept OUT of `csdlp update` deliberately. Both rewrite an on-disk format, and
# neither can be undone by re-tagging the image the way a manager rollback can:
# once the data directory is converted, the old engine will not open it. So they
# are separate, explicit, confirmed commands that keep the old data until you
# delete it yourself.

_confirm() {
    printf '  %s%s%s\n' "$CY" "$1" "$C0"
    printf '  type YES to continue: '
    local a; read -r a
    [ "$a" = "YES" ] || { warn "aborted"; return 1; }
}

# Rewrite one service's image tag in the compose file, in place.
_set_image() {
    local svc="$1" newimg="$2" line
    line="$(grep -n "^  ${svc}:" "$COMPOSE" | head -1 | cut -d: -f1)"
    [ -n "$line" ] || { err "service $svc not found in $COMPOSE"; return 1; }
    # the image: line is within the next few lines of the service key
    local img_line
    img_line="$(awk -v s="$line" 'NR>s && NR<=s+6 && /^[[:space:]]+image:/ {print NR; exit}' "$COMPOSE")"
    [ -n "$img_line" ] || { err "no image: line for $svc"; return 1; }
    sed -i "${img_line}s|image: .*|image: ${newimg}|" "$COMPOSE"
    ok "$COMPOSE: $svc -> $newimg"
}

cmd_upgrade_postgres() {
    local target="${1:-}" cur vol volpre pgu pgd dump ts rows_before rows_after
    cur="$(_svc_image postgres)"
    [ -n "$cur" ] || { err "no postgres image in $COMPOSE"; return 1; }
    if [ -z "$target" ]; then
        local out; out="$(_upstream_state "$cur")" || out=""
        target="$(printf '%s' "$out" | awk '{print $4}')"
        [ "$target" = "-" ] && { ok "postgres is already on the newest major ($cur)"; return 0; }
        [ -n "$target" ] || { err "could not determine the newest postgres; pass one: csdlp upgrade-postgres 18-alpine"; return 1; }
    fi
    hd "Postgres major upgrade: ${cur##*:} -> $target"

    pgu="$(_pg_user)"; pgd="$(_pg_db)"
    # From the RUNNING container, not from `compose config`. Compose reports the
    # short name declared in the file ("postgres_data"); the real volume carries
    # the project prefix ("<project>_postgres_data"). Acting on the short name
    # creates a new empty volume, so the "backup" copies nothing and the data it
    # was supposed to protect is still sitting in the volume being cleared.
    vol="$(docker inspect "$(dc ps -q postgres | head -1)" \
           --format '{{range .Mounts}}{{if or (eq .Destination "/var/lib/postgresql/data") (eq .Destination "/var/lib/postgresql")}}{{.Name}}{{end}}{{end}}' 2>/dev/null)"
    [ -n "$vol" ] || { err "could not resolve the postgres data volume (is postgres running?)"; return 1; }
    docker volume inspect "$vol" >/dev/null 2>&1 || { err "volume $vol does not exist"; return 1; }
    ok "data volume: $vol"
    ts="$(date +%Y%m%d-%H%M%S)"; volpre="${vol}_pre_${ts}"

    _confirm "This rewrites the Postgres data directory. The old volume is KEPT as ${volpre}." || return 1

    ok "1/7 dumping the database"
    mkdir -p "$DIR/backups/$ts"; dump="$DIR/backups/$ts/postgres-pre-upgrade.sql"
    # stderr is KEPT. Sending it to /dev/null turned every possible cause -
    # wrong role, missing maintenance database, permission denied, a server that
    # is not up yet - into the same four words, "dump is empty", with nothing to
    # act on. Whatever postgres says, the operator gets to see.
    local dumperr; dumperr="$(mktemp)"
    _pg_run pg_dumpall > "$dump" 2>"$dumperr"
    if [ ! -s "$dump" ]; then
        err "dump is empty — refusing to go further"
        err "pg_dumpall -U $pgu said:"
        sed 's/^/        /' "$dumperr" | head -10 >&2
        [ -s "$dumperr" ] || err "        (no output at all — is the postgres container running?)"
        printf '      resolved user=%s db=%s\n' "$pgu" "$pgd" >&2
        printf '      tried:%s\n' "$(_pg_tried)" >&2
        printf '      try:  docker compose -f %s exec -T postgres psql -U %s -l\n' "$COMPOSE" "$pgu" >&2
        rm -f "$dumperr"
        return 1
    fi
    rm -f "$dumperr"
    ok "    $dump ($(wc -c < "$dump") bytes)"
    rows_before="$(_pg_run psql -d "$pgd" -Atc \
        "SELECT count(*) FROM information_schema.tables WHERE table_schema='public'" 2>/dev/null | tr -d '\r')"
    ok "    tables before: ${rows_before:-?}"

    ok "2/7 stopping the stack"
    dc down >/dev/null 2>&1

    ok "3/7 preserving the old volume as $volpre"
    docker volume create "$volpre" >/dev/null
    docker run --rm -v "$vol":/from -v "$volpre":/to alpine \
        sh -c 'cd /from && cp -a . /to' >/dev/null 2>&1 \
        || { err "could not copy the old volume — nothing has been changed"; dc up -d >/dev/null 2>&1; return 1; }
    ok "    copied"

    ok "4/7 clearing the data volume for $target"
    docker run --rm -v "$vol":/d alpine sh -c 'rm -rf /d/* /d/..?* 2>/dev/null; true' >/dev/null 2>&1

    ok "5/7 switching the image"
    _set_image postgres "postgres:$target" || return 1

    # Postgres 18 refuses to start when the cluster sits directly ON the mount
    # point: it reports "PostgreSQL data in /var/lib/postgresql/data (unused
    # mount/volume)". What it wants is the cluster in a SUBDIRECTORY of the
    # mount, so pg_upgrade --link never crosses a mount boundary.
    #
    # There are two ways to satisfy that, and only one of them is safe to apply
    # blind. Moving the mount up a level works where PGDATA is unset - and
    # breaks a deployment that sets PGDATA explicitly, because the mount moves
    # out from under a path that stays where it was. That is exactly how this
    # failed on a deployment carrying PGDATA=/var/lib/postgresql/data/pgdata
    # while it had worked on one that carried none.
    #
    # Setting PGDATA to a subdirectory satisfies 18 either way and leaves the
    # mount alone, so that is what is done - and where PGDATA is already a
    # subdirectory, nothing needs doing at all.
    local tmaj="${target%%.*}"; tmaj="${tmaj%%-*}"
    if [ "${tmaj:-0}" -ge 18 ] 2>/dev/null; then
        local pgdata_line
        pgdata_line="$(awk '/^  postgres:/{f=1} f && /^  [a-zA-Z_-]+:[[:space:]]*$/ && !/^  postgres:/{exit} f && /PGDATA/{print; exit}' "$COMPOSE")"
        if [ -n "$pgdata_line" ]; then
            ok "    PGDATA already set — mount left alone (${pgdata_line##*[[:space:]]})"
        else
            local envline
            envline="$(awk '/^  postgres:/{f=1} f && /^[[:space:]]+environment:[[:space:]]*$/{print NR; exit}' "$COMPOSE")"
            if [ -n "$envline" ]; then
                sed -i "${envline}a\      PGDATA: /var/lib/postgresql/data/pgdata" "$COMPOSE"
                ok "    PGDATA set to a subdirectory of the mount (required from 18)"
            else
                warn "    could not find the postgres environment block to set PGDATA"
                warn "    add  PGDATA: /var/lib/postgresql/data/pgdata  by hand if 18 refuses to start"
            fi
        fi
    fi

    ok "6/7 starting postgres and restoring"
    dc up -d postgres >/dev/null 2>&1
    # A fresh major runs initdb before it will accept anything, and on a modest
    # VM that is minutes, not seconds. The old budget here was 120s: postgres
    # was still initialising, this gave up, and - because it gave up BEFORE the
    # restore below - left a correctly upgraded but EMPTY cluster while
    # reporting failure. The stack then looked healthy, because a health check
    # that only proves connectivity is perfectly happy with an empty database.
    #
    # 10 minutes, with progress, and -U omitted: pg_isready only needs to know
    # whether the server is accepting connections, and passing a role that does
    # not exist in the new cluster yet would answer the wrong question.
    local i=0 waited=""
    until dc exec -T postgres pg_isready >/dev/null 2>&1; do
        i=$((i + 1))
        if [ "$i" -gt 300 ]; then
            err "postgres did not become ready after 10 minutes"
            err "the data volume has been cleared and NOT yet restored."
            err "  dump:            $dump"
            err "  original volume: $volpre"
            err "recover with:  csdlp restore $(dirname "$dump")"
            return 1
        fi
        if [ $((i % 15)) -eq 0 ]; then waited="$((i * 2))s"; printf '      still initialising (%s)...\n' "$waited"; fi
        sleep 2
    done
    ok "    postgres $target accepting connections"
    _pg_run psql -d postgres < "$dump" >/dev/null 2>&1
    rows_after="$(_pg_run psql -d "$pgd" -Atc \
        "SELECT count(*) FROM information_schema.tables WHERE table_schema='public'" 2>/dev/null | tr -d '\r')"
    ok "    tables after: ${rows_after:-?}"
    if [ "${rows_before:-x}" != "${rows_after:-y}" ]; then
        err "table count changed (${rows_before} -> ${rows_after}) — restore is INCOMPLETE"
        err "the old data is intact in volume $volpre; the dump is at $dump"
        return 1
    fi

    ok "7/7 starting the rest of the stack"
    dc up -d >/dev/null 2>&1
    if _health_ok; then
        ok "postgres now on $target — healthy"
        warn "old data kept in volume $volpre; remove it when you are satisfied:"
        printf '        docker volume rm %s\n' "$volpre"
    else
        err "unhealthy after the upgrade — old data is in $volpre, dump at $dump"
        return 1
    fi
}

cmd_upgrade_mongo() {
    local target="${1:-}" cur mu mp ts arch before after fcv
    cur="$(_svc_image mongodb)"
    [ -n "$cur" ] || { err "no mongodb image in $COMPOSE"; return 1; }
    if [ -z "$target" ]; then
        local out; out="$(_upstream_state "$cur")" || out=""
        target="$(printf '%s' "$out" | awk '{print $4}')"
        [ "$target" = "-" ] && { ok "mongo is already on the newest major ($cur)"; return 0; }
        # MongoDB majors must be taken one at a time, and only the .0 line is
        # an LTS — 8.3 is a rapid release. Land on <major>.0 regardless of what
        # the registry's newest tag happens to be.
        target="${target%%.*}.0"
    fi
    hd "MongoDB major upgrade: ${cur##*:} -> $target"

    mu="$(_mg_user)"; mp="$(_mg_pass)"
    ts="$(date +%Y%m%d-%H%M%S)"; mkdir -p "$DIR/backups/$ts"
    arch="$DIR/backups/$ts/mongo-pre-upgrade.archive"

    _confirm "MongoDB majors must be taken one at a time and cannot be downgraded after the FCV is raised." || return 1

    ok "1/6 dumping"
    dc exec -T mongodb sh -c "mongodump --quiet --username '$mu' --password '$mp' --authenticationDatabase admin --archive" > "$arch" 2>/dev/null
    [ -s "$arch" ] || { err "dump is empty — refusing to go further"; return 1; }
    ok "    $arch ($(wc -c < "$arch") bytes)"
    before="$(_mongo_collcount "$mu" "$mp")"
    ok "    collections before: ${before:-?}"

    ok "2/6 pinning featureCompatibilityVersion to the CURRENT major first"
    fcv="${cur##*:}"; fcv="${fcv%%-*}"; fcv="$(printf '%s' "$fcv" | cut -d. -f1).0"
    _mongo_eval "$mu" "$mp" "db.adminCommand({setFeatureCompatibilityVersion:'$fcv',confirm:true})" >/dev/null 2>&1 \
      || _mongo_eval "$mu" "$mp" "db.adminCommand({setFeatureCompatibilityVersion:'$fcv'})" >/dev/null 2>&1
    ok "    fcv = $(_mongo_eval "$mu" "$mp" 'db.adminCommand({getParameter:1,featureCompatibilityVersion:1}).featureCompatibilityVersion.version')"

    ok "3/6 switching the image"
    _set_image mongodb "mongo:$target" || return 1

    ok "4/6 restarting mongodb"
    dc up -d mongodb >/dev/null 2>&1
    local i=0
    until _mongo_eval "$mu" "$mp" 'db.adminCommand({ping:1}).ok' 2>/dev/null | grep -q 1; do
        i=$((i + 1)); [ "$i" -gt 60 ] && { err "mongodb did not come back — dump is at $arch"; return 1; }
        sleep 2
    done

    ok "5/6 raising featureCompatibilityVersion to $target"
    _mongo_eval "$mu" "$mp" "db.adminCommand({setFeatureCompatibilityVersion:'$target',confirm:true})" >/dev/null 2>&1 \
      || _mongo_eval "$mu" "$mp" "db.adminCommand({setFeatureCompatibilityVersion:'$target'})" >/dev/null 2>&1
    ok "    fcv = $(_mongo_eval "$mu" "$mp" 'db.adminCommand({getParameter:1,featureCompatibilityVersion:1}).featureCompatibilityVersion.version')"

    after="$(_mongo_collcount "$mu" "$mp")"
    ok "    collections after: ${after:-?}"
    [ "${before:-x}" = "${after:-y}" ] || { err "collection count changed (${before} -> ${after}) — dump is at $arch"; return 1; }

    ok "6/6 restarting the stack"
    dc up -d >/dev/null 2>&1
    _health_ok && ok "mongodb now on $target — healthy" \
               || { err "unhealthy after the upgrade — dump at $arch"; return 1; }
}

# Total collections across every non-system database.
#
# This used to name one database literally, which is the same mistake _pg_db()
# exists to prevent: the dev stack's database is cybersentinel_dlp, not
# cybersentineldlp, so the check counted zero before and zero after and would
# have called a total data loss a clean upgrade.
_mongo_collcount() {
    _mongo_eval "$1" "$2" '
        var n = 0;
        db.adminCommand({listDatabases:1}).databases.forEach(function(x){
            if (["admin","config","local"].indexOf(x.name) < 0) {
                n += db.getSiblingDB(x.name).getCollectionNames().length;
            }
        });
        print(n);'
}

_mongo_eval() {
    local mu="$1" mp="$2" js="$3"
    dc exec -T mongodb mongosh --quiet -u "$mu" -p "$mp" --authenticationDatabase admin \
        --eval "$js" 2>/dev/null | tr -d '\r' | tail -1
}

cmd_rollback() {
    hd "Rollback"
    local pv="$DIR/.csdlp/prev-versions" restored=0 pin="" role ref used
    [ -f "$pv" ] || { err "no saved versions to roll back to (.csdlp/prev-versions missing)"; return 1; }
    while read -r role ref; do
        [ -n "$ref" ] || continue
        case "$role" in
            manager)
                if used="$(_restore_img "$MANAGER_IMG" "$ref")"; then
                    ok "manager re-pinned to $used"; restored=$((restored + 1))
                    case "$ref" in tag:*) pin="${ref#tag:}";; esac
                else
                    err "manager: saved version '$ref' could not be restored (pruned locally and not pullable)"
                fi;;
            dashboard)
                [ -n "$DASH_IMG" ] || continue
                if used="$(_restore_img "$DASH_IMG" "$ref")"; then
                    ok "dashboard re-pinned to $used"; restored=$((restored + 1))
                else
                    err "dashboard: saved version '$ref' could not be restored (pruned locally and not pullable)"
                fi;;
        esac
    done < "$pv"
    [ "$restored" -gt 0 ] || { err "nothing could be restored — investigate with: csdlp doctor"; return 1; }
    # Pin the known-good tag so the next bare `csdlp update` cannot silently
    # re-pull the :latest we just rolled away from.
    if [ -n "$pin" ]; then
        mkdir -p "$DIR/.csdlp"; printf '%s\n' "$pin" > "$DIR/.csdlp/pinned"
        ok "pinned to $pin — run 'csdlp update latest' to release"
    fi
    dc up -d
    _health_ok && ok "rolled back + healthy" || err "still unhealthy after rollback — investigate with: csdlp doctor"
}

cmd_secret() {
    case "${1:-}" in
        admin-password)
            dc logs manager 2>&1 | grep -oE '"generated_password": "[^"]+"' | head -1 \
                | sed -e 's/^"generated_password": "//' -e 's/"$//' \
                || warn "no generated_password in manager logs (admin may have pre-existed / was set via DLP_ADMIN_PASSWORD)";;
        *) err "usage: csdlp secret admin-password";;
    esac
}

cmd_version() {
    hd "Versions"
    kv "manager image" "$MANAGER_IMG"
    docker image inspect "$MANAGER_IMG" --format '  {{"image id     "}} {{.Id}}' 2>/dev/null
    # The commit this image was built from — only present on CI builds, which
    # carry the sha-<commit> tag and the OCI revision label.
    local mref="$(_img_ref "$MANAGER_IMG")"
    case "$mref" in
        tag:*) kv "build ref" "${mref#tag:} (immutable, re-pullable)";;
        id:*)  kv "build ref" "local image only — no CI provenance, not re-pullable";;
    esac
    [ -f "$DIR/.csdlp/pinned" ] && kv "pinned" "$(cat "$DIR/.csdlp/pinned") (after a rollback)"
    local h; h="$(mgr_curl http://localhost:55100/health)"
    [ -n "$h" ] && kv "api version" "$(printf '%s' "$h" | grep -oE '"version":"[^"]*"' | cut -d: -f2 | tr -d '"')"
}

cmd_restart() {
    local svc="${1:-}"
    hd "Restart ${svc:-all}"
    # shellcheck disable=SC2086
    dc restart $svc && ok "restarted"
}

# A duplicated key in .env is silently legal and quietly divisive: compose reads
# the last, a careless reader reads the first, and the two can describe
# different deployments. Cheap to detect, so detect it.
_warn_dup_env() {
    [ -f "$ENVF" ] || return 0
    local dups
    dups="$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*=' "$ENVF" | sort | uniq -d | tr -d '=')"
    [ -n "$dups" ] || return 0
    warn "$ENVF defines these keys more than once — the LAST one wins:"
    local k
    for k in $dups; do
        printf '        %-24s -> %s\n' "$k" "$(sed -n "s/^$k=//p" "$ENVF" | tail -1 | tr -d '"'"'"' ')"
    done
    return 1
}

cmd_doctor() {
    local bundle=""; [ "${1:-}" = "--bundle" ] && bundle=1
    local out; out="$(mktemp)"
    {
        hd "csdlp doctor — $(date -u +%FT%TZ 2>/dev/null || echo now)"
        kv "dir" "$DIR"; kv "compose" "$COMPOSE"; kv "manager image" "$MANAGER_IMG"
        echo; hd "services"; dc ps
        echo; hd "manager /health"; mgr_curl http://localhost:55100/health || echo "  (unreachable)"
        echo; echo
        hd "dependency probes"
        local pgu; pgu="$(envget POSTGRES_USER)"; pgu="${pgu:-dlp_user}"
        dc exec -T postgres pg_isready -U "$pgu" >/dev/null 2>&1 && ok "postgres ready" || err "postgres not ready"
        local rp; rp="$(envget REDIS_PASSWORD)"
        dc exec -T redis sh -c "redis-cli ${rp:+-a '$rp'} ping" 2>/dev/null | grep -q PONG && ok "redis PONG" || err "redis not responding"
        dc exec -T mongodb mongosh --quiet --eval 'db.runCommand({ping:1}).ok' 2>/dev/null | grep -q 1 && ok "mongodb ping" || warn "mongodb ping unclear"
        local op; op="$(envget OPENSEARCH_PASSWORD)"
        dc exec -T opensearch sh -c "curl -sk -u admin:'$op' https://localhost:9200/_cluster/health" 2>/dev/null | grep -oE '"status":"[^"]*"' | head -1 | sed 's/^/  opensearch /' || warn "opensearch unclear"
        echo; hd "recent errors per service (last 40 lines each)"
        for s in manager celery-worker dashboard; do
            echo "--- $s ---"
            dc logs --tail=40 "$s" 2>&1 | grep -iE 'error|critical|traceback|exception|failed' | tail -8
        done
        echo; hd "host resources"
        df -h "$DIR" 2>/dev/null | tail -1
        free -h 2>/dev/null | sed -n '2p'
        echo; hd ".env sanity (secrets redacted)"
        [ -f "$ENVF" ] && grep -vE '^\s*#|^\s*$' "$ENVF" | sed -E 's/^([A-Za-z0-9_]*(PASSWORD|SECRET|KEY)[A-Za-z0-9_]*)=.*/\1=<redacted>/'
    } | tee "$out"
    if [ -n "$bundle" ]; then
        local tb="$DIR/csdlp-doctor-$(date +%Y%m%d-%H%M%S).txt"
        cp "$out" "$tb"; echo; ok "bundle written: $tb (share this)"
    fi
    rm -f "$out"
}


# ── SSO trust anchor ──────────────────────────────────────────────────────
#
# SSO from the SIEM is verified with RS256: the SIEM signs the handoff token
# with its PRIVATE key and the DLP verifies it with the PUBLIC key it fetches
# from the SIEM's JWKS URL. That fetch is the whole trust anchor — anyone who
# can impersonate the JWKS host can hand us their own public key and mint
# tokens we would accept — so it is verified TLS, always.
#
# A SIEM on a private IP with a self-signed certificate is not in any public CA
# store, so that verification fails until this machine is told which
# certificate to expect. That is what this command does: install the SIEM's
# certificate as a trust anchor for this one connection. There is deliberately
# no "skip verification" option anywhere in the product.
CERTS_DIR="$DIR/certs"
CERT_FILE="$CERTS_DIR/siem-jwks.pem"
CERT_IN_CONTAINER="/etc/cybersentineldlp/certs/siem-jwks.pem"

_cert_summary() {
    local f="$1"
    command -v openssl >/dev/null 2>&1 || { warn "openssl not on this host — cannot summarise the certificate"; return 0; }
    kv "subject"  "$(openssl x509 -in "$f" -noout -subject 2>/dev/null | sed 's/^subject=//')"
    kv "issuer"   "$(openssl x509 -in "$f" -noout -issuer  2>/dev/null | sed 's/^issuer=//')"
    kv "names"    "$(openssl x509 -in "$f" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' ' | tr '\n' ' ')"
    local nb na; nb="$(openssl x509 -in "$f" -noout -startdate 2>/dev/null | cut -d= -f2)"
    na="$(openssl x509 -in "$f" -noout -enddate 2>/dev/null | cut -d= -f2)"
    kv "valid"    "$nb  ->  $na"
    # Expiry is the failure nobody schedules. The JWKS fetch fails CLOSED, so
    # the morning this certificate lapses every SSO login stops with a TLS
    # error and nothing else on the dashboard looks wrong.
    if openssl x509 -in "$f" -noout -checkend 0 >/dev/null 2>&1; then
        if ! openssl x509 -in "$f" -noout -checkend 2592000 >/dev/null 2>&1; then
            warn "expires in under 30 days — SSO logins will stop when it does"
        fi
    else
        err "this certificate has ALREADY EXPIRED — SSO will not work with it"
    fi
    if openssl x509 -in "$f" -noout -subject -issuer 2>/dev/null | awk -F'=' 'NR==1{s=$0} NR==2{i=$0} END{exit !(substr(s,9)==substr(i,8))}'; then
        kv "type" "self-signed (pins this exact certificate; reinstall on renewal)"
    fi
}

cmd_sso_cert() {
    local sub="${1:-show}"; shift || true
    mkdir -p "$CERTS_DIR"
    case "$sub" in
        fetch)
            # Pull the certificate the SIEM actually presents. Better than being
            # emailed a file: what is installed is then, by construction, what
            # the server serves.
            local hostport="${1:-}"
            [ -n "$hostport" ] || { err "usage: csdlp sso-cert fetch <host:port>   (e.g. 10.200.10.23:3000)"; return 1; }
            command -v openssl >/dev/null 2>&1 || { err "openssl is required for fetch"; return 1; }
            hd "fetching the certificate presented by $hostport"
            local tmp; tmp="$(mktemp)"
            if ! openssl s_client -connect "$hostport" -servername "${hostport%%:*}" </dev/null 2>/dev/null \
                 | openssl x509 -outform pem > "$tmp" 2>/dev/null || [ ! -s "$tmp" ]; then
                rm -f "$tmp"; err "could not retrieve a certificate from $hostport"; return 1
            fi
            _cert_summary "$tmp"
            echo
            warn "fetched over an UNVERIFIED connection — confirm the fingerprint below with"
            warn "whoever runs the SIEM before trusting it:"
            kv "sha256" "$(openssl x509 -in "$tmp" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2)"
            echo
            cmd_sso_cert install "$tmp"
            rm -f "$tmp"
            ;;
        install)
            local src="${1:-}"
            [ -n "$src" ] || { err "usage: csdlp sso-cert install <file.pem|->   ('-' reads stdin)"; return 1; }
            local tmp; tmp="$(mktemp)"
            if [ "$src" = "-" ]; then cat > "$tmp"; else cp "$src" "$tmp" 2>/dev/null || { rm -f "$tmp"; err "cannot read $src"; return 1; }; fi

            # A trust store holds public certificates and nothing else. Refusing
            # a private key here is not paranoia: the SIEM's key and its
            # certificate are usually handed over together, the file names look
            # alike, and this directory is world-readable inside the container.
            if grep -q "PRIVATE KEY" "$tmp"; then
                rm -f "$tmp"
                err "that file contains a PRIVATE KEY. Only the certificate belongs here."
                err "Send the public certificate instead (the -----BEGIN CERTIFICATE----- block)."
                return 1
            fi
            if ! grep -q "BEGIN CERTIFICATE" "$tmp"; then
                rm -f "$tmp"; err "no PEM certificate found in that input"; return 1
            fi
            if command -v openssl >/dev/null 2>&1 && ! openssl x509 -in "$tmp" -noout >/dev/null 2>&1; then
                rm -f "$tmp"; err "that is not a valid PEM certificate"; return 1
            fi

            hd "installing the SIEM JWKS trust anchor"
            _cert_summary "$tmp"
            cat "$tmp" > "$CERT_FILE"; chmod 0644 "$CERT_FILE"; rm -f "$tmp"
            ok "written: $CERT_FILE"

            envset SIEM_JWKS_CA_BUNDLE "$CERT_IN_CONTAINER"
            ok "SIEM_JWKS_CA_BUNDLE=$CERT_IN_CONTAINER in $(basename "$ENVF")"

            # `up -d` and not `restart`: restart reuses the old environment, so
            # the container would come back without ever seeing the new value.
            hd "applying to the manager"
            dc up -d manager >/dev/null 2>&1 && ok "manager recreated with the new environment" \
                                             || err "could not recreate the manager"
            sleep 3
            cmd_sso_cert check
            ;;
        check)
            hd "SSO trust anchor"
            local url bundle
            url="$(envget SIEM_JWKS_URL)"; bundle="$(envget SIEM_JWKS_CA_BUNDLE)"
            kv "SIEM_JWKS_URL" "${url:-<unset — SSO falls back to HS256 with DLP_SSO_SECRET>}"
            kv "CA bundle"     "${bundle:-<unset — the system CA store is used>}"
            [ -f "$CERT_FILE" ] && _cert_summary "$CERT_FILE"
            if [ -n "$bundle" ]; then
                # Branch on the ANSWER, not on the exit code. `exec` fails for
                # reasons that have nothing to do with the file — a stopped
                # manager, or a compose file that cannot be interpolated — and
                # reporting every one of those as "the certificate is not
                # mounted" sends you to fix a mount that was never broken.
                local seen
                seen="$(dc exec -T manager sh -c "test -f '$bundle' && echo PRESENT || echo MISSING" 2>/dev/null | tr -d '\r' | tail -1)"
                case "$seen" in
                    PRESENT) ok "bundle is present inside the manager container" ;;
                    MISSING) err "the manager is running but $bundle is not there — is ./certs mounted?"; return 1 ;;
                    *)       err "could not ask the manager (is it running? is $COMPOSE the right compose file?)"
                             warn "on a dev box: CSDLP_COMPOSE=docker-compose.yml csdlp sso-cert check"
                             return 1 ;;
                esac
            fi
            [ -n "$url" ] || {
                warn "no SIEM_JWKS_URL set, so there is nothing to fetch yet"
                warn "set it with: csdlp sso-cert url https://<siem-host>:<port>/api/sso/jwks.json"
                return 0
            }

            # Verified exactly the way the application does it, from inside the
            # container the application runs in. A curl from the host proves
            # nothing about either.
            echo; hd "fetching the JWKS the way the manager will"
            local out
            # Reports the manager's OWN view of the settings before fetching.
            # .env is what you edited; this is what the running container was
            # started with, and an edit that never reached it is invisible
            # otherwise — the display shows the new values while the failure
            # comes from the old ones.
            out="$(dc exec -T manager python -c "
import asyncio
from app.core.config import settings
from app.core.sso_jwks import _fetch
print('ENV_URL ' + (settings.SIEM_JWKS_URL or ''))
print('ENV_CA ' + (settings.SIEM_JWKS_CA_BUNDLE or ''))
try:
    ks = asyncio.run(_fetch(settings.SIEM_JWKS_URL))
    print('OK ' + str(len(ks)) + ' key(s): ' + ','.join(
        (k.get('kid') or '?') + '/' + (k.get('alg') or k.get('kty') or '?') for k in ks))
except Exception as e:
    print('FAIL ' + type(e).__name__ + ': ' + str(e)[:300])
" 2>/dev/null | tr -d '\r')"

            local live_url live_ca stale=""
            live_url="$(printf '%s\n' "$out" | sed -n 's/^ENV_URL //p' | head -1)"
            live_ca="$(printf '%s\n' "$out" | sed -n 's/^ENV_CA //p'  | head -1)"
            out="$(printf '%s\n' "$out" | grep -vE '^ENV_(URL|CA) ')"
            if [ -n "$out" ]; then
                [ "$live_url" = "$url" ]    || stale="SIEM_JWKS_URL"
                [ "$live_ca"  = "$bundle" ] || stale="${stale:+$stale and }SIEM_JWKS_CA_BUNDLE"
            fi
            if [ -n "$stale" ]; then
                warn "the manager is running with a DIFFERENT $stale than $(basename "$ENVF") says"
                kv "  manager has" "${live_url:-<unset>}  |  ${live_ca:-<unset>}"
                warn "it has not been recreated since that edit — fix with: csdlp restart manager"
                warn "(or: docker compose -f $COMPOSE up -d manager)"
                echo
            fi
            case "$out" in
                OK*)   ok "${out#OK }" ; ok "SSO can verify tokens from this SIEM" ;;
                FAIL*) err "${out#FAIL }"
                       echo
                       warn "if this is a certificate error, the SIEM is presenting something other"
                       warn "than what is installed — re-run: csdlp sso-cert fetch <host:port>" ;;
                *)     err "could not run the check inside the manager container"
                       [ -n "$out" ] && echo "  $out" ;;
            esac
            ;;
        url)
            # The other half of the pair. Without it the trust anchor is
            # installed and unused, and `check` can only say "nothing to fetch"
            # — so setting it belongs in the same command rather than in a
            # hand-edit of .env that is easy to skip on a new server.
            local u="${1:-}"
            [ -n "$u" ] || { err "usage: csdlp sso-cert url <jwks-url>   (e.g. https://10.200.10.23:3000/api/sso/jwks.json)"; return 1; }
            case "$u" in
                https://*) ;;
                http://*)  err "refusing an http:// JWKS URL — this document is the trust anchor for every SSO login"; return 1 ;;
                *)         err "that does not look like a URL"; return 1 ;;
            esac
            envset SIEM_JWKS_URL "$u"
            ok "SIEM_JWKS_URL=$u in $(basename "$ENVF")"
            dc up -d manager >/dev/null 2>&1 && ok "manager recreated with the new environment" \
                                             || err "could not recreate the manager"
            sleep 3
            cmd_sso_cert check
            ;;
        show|"")
            cmd_sso_cert check
            ;;
        *) err "unknown sso-cert subcommand: $sub"; echo "  try: url | fetch | install | check"; return 1;;
    esac
}

cmd_self_update() {
    local repo="${CSDLP_REPO:-effaaykhan/cybersentineldlp-prod}"
    local branch="${CSDLP_BRANCH:-main}"
    local raw="https://raw.githubusercontent.com/${repo}/${branch}"
    local auth=() tok; tok="$(envget AGENT_DIST_TOKEN)"
    [ -n "$tok" ] && auth=(-H "Authorization: Bearer $tok")
    hd "Self-update from ${repo}@${branch}"

    # 1. the compose file is NEVER overwritten.
    #
    # `csdlp upgrade-postgres` and `upgrade-mongo` rewrite it as part of a
    # migration - the image pin and, from Postgres 18, the mount path. Pulling
    # the repo copy over that would put a 16-alpine pin back in front of an
    # 18 data directory, which is a stack that will not start and a operator
    # with no idea why. Fetch it alongside and let a human merge.
    local newc; newc="$DIR/${COMPOSE}.new"
    if curl -fsSL "${auth[@]}" --max-time 60 "$raw/${COMPOSE}" -o "$newc" 2>/dev/null && [ -s "$newc" ]; then
        if cmp -s "$newc" "$DIR/$COMPOSE"; then
            rm -f "$newc"; ok "$COMPOSE already current"
        else
            warn "$COMPOSE differs from the repository — NOT overwritten"
            printf '    saved as %s\n' "$newc"
            if command -v diff >/dev/null 2>&1; then
                printf '    image lines that differ:\n'
                diff <(grep -E '^\s+image:|:/var/lib/postgresql' "$DIR/$COMPOSE") \
                     <(grep -E '^\s+image:|:/var/lib/postgresql' "$newc") \
                     | sed 's/^/      /'
            fi
            printf '    review, then:  mv %s %s/%s\n' "$newc" "$DIR" "$COMPOSE"
        fi
    else
        warn "could not download $COMPOSE"
    fi

    # 2. the script itself, LAST.
    #
    # It returns as soon as it has swapped, so anything that must happen
    # during this run has to happen above it.
    #
    # Replaced by RENAME, never by writing over it. bash does not read a script
    # into memory - it parses and executes incrementally, holding a byte offset
    # into the open file. Truncating and rewriting that same inode while it is
    # the script currently running leaves bash to resume at its old offset in
    # different content, landing mid-statement:
    #
    #     /usr/local/bin/csdlp: line 1179: syntax error near unexpected token `)'
    #
    # rename(2) swaps the directory entry instead. The running process keeps the
    # original inode, now unlinked, and finishes reading it undisturbed; every
    # later invocation gets the new file. The temp file is created in the SAME
    # directory so the rename cannot fall back to a cross-filesystem copy, which
    # would truncate the destination and reintroduce exactly this bug.
    local tmp; tmp="$(mktemp "$DIR/.csdlp.XXXXXX")" || { err "cannot write to $DIR"; return 1; }
    if curl -fsSL "${auth[@]}" --max-time 60 "$raw/csdlp" -o "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
        if head -1 "$tmp" | grep -q '^#!/usr/bin/env bash' && bash -n "$tmp" 2>/dev/null; then
            if cmp -s "$tmp" "$DIR/csdlp"; then
                rm -f "$tmp"; ok "csdlp already current"
            else
                cp "$DIR/csdlp" "$DIR/csdlp.prev" 2>/dev/null
                chmod +x "$tmp"
                if mv -f "$tmp" "$DIR/csdlp"; then
                    ok "csdlp updated (previous kept as csdlp.prev)"
                    if [ "$(readlink -f /usr/local/bin/csdlp 2>/dev/null)" = "$(readlink -f "$DIR/csdlp" 2>/dev/null)" ]; then
                        ok "/usr/local/bin/csdlp is a symlink to it — nothing more to do"
                    elif [ -w /usr/local/bin ]; then
                        local t2; t2="$(mktemp /usr/local/bin/.csdlp.XXXXXX 2>/dev/null)"
                        if [ -n "$t2" ] && cp "$DIR/csdlp" "$t2" && chmod +x "$t2" && mv -f "$t2" /usr/local/bin/csdlp; then
                            ok "/usr/local/bin/csdlp updated"
                        else
                            rm -f "$t2" 2>/dev/null
                            warn "could not update /usr/local/bin/csdlp"
                        fi
                    fi
                    # This process is still executing the OLD file. Stop here
                    # rather than run a mix of two versions.
                    ok "done — the new version is in place for the next command"
                    return 0
                else
                    rm -f "$tmp"; err "could not replace $DIR/csdlp"
                fi
            fi
        else
            rm -f "$tmp"; err "downloaded csdlp is not a valid script — keeping the current one"
        fi
    else
        rm -f "$tmp"; err "could not download csdlp (private repo? set AGENT_DIST_TOKEN in .env)"
    fi
}

cmd_self_install() {
    local dest="/usr/local/bin/csdlp"
    # install.sh puts a SYMLINK at $dest pointing back here, so on a normal
    # deployment $dest already resolves to $0 and cp refuses to copy a file onto
    # itself: "are the same file", reported as "install failed (need root?)" to
    # an operator who is root and whose install is in fact perfectly correct.
    # Curling a new csdlp over the symlink target has already updated PATH.
    if [ -e "$dest" ] && [ "$(readlink -f "$dest" 2>/dev/null)" = "$(readlink -f "$0" 2>/dev/null)" ]; then
        ok "already on PATH as $dest -> $(readlink -f "$0")"
        return 0
    fi
    cp "$0" "$dest" && chmod +x "$dest" && ok "installed to $dest" || err "install failed (need root?)"
}

usage() {
    printf '%scsdlp%s — CyberSentinel DLP operations CLI  %s(one tool for the whole stack)%s\n' "$CB" "$C0" "$CD" "$C0"
    printf '%susage:%s csdlp <command> [args]\n\n' "$CD" "$C0"

    printf '%sOPERATE & INSPECT%s\n' "$CG" "$C0"
    printf '  %-26s %s\n' "status"        "Health of every service + API version + DB checks, then \`ps\`."
    printf '  %-26s %s\n' "ps"            "List the stack's containers and their state (docker compose ps)."
    printf '  %-26s %s\n' "logs [svc] [-f]" "Tail the last 200 log lines; a service name narrows it, -f follows live."
    printf '  %-26s %s\n' "version"       "Show the deployed manager image + the running API version."
    printf '  %-26s %s\n' "doctor [--bundle]" "Full diagnostics: services, /health, per-dependency probes,"
    printf '  %-26s %s\n' ""              "recent errors per service, host disk/mem, and .env with secrets"
    printf '  %-26s %s\n' ""              "REDACTED. --bundle also writes a shareable text file to send you."

    printf '\n%sUPDATE & RECOVER%s\n' "$CG" "$C0"
    printf '  %-26s %s\n' "update [TAG]"  "Safe update: snapshot versions + DB backup -> pull (or a specific"
    printf '  %-26s %s\n' ""              "image TAG) -> migrate -> up -> health-gate; AUTO-ROLLS-BACK if the"
    printf '  %-26s %s\n' ""              "stack is unhealthy afterwards."
    printf '  %-26s %s\n' "rollback"      "Revert the images to the versions saved before the last update, up,"
    printf '  %-26s %s\n' ""              "and re-check health. Re-pulls the immutable sha-<commit> tag when the"
    printf '  %-26s %s\n' ""              "image came from CI, so it works even if the old image was pruned;"
    printf '  %-26s %s\n' ""              "then PINS that version so the next bare update cannot undo it."
    printf '  %-26s %s\n' ""              "Release the pin with: csdlp update latest"
    printf '  %-26s %s\n' "migrate"       "Run database schema migrations (alembic upgrade head). Idempotent."
    printf '  %-26s %s\n' "check-updates"  "What upstream versions are newer than the pins. Changes nothing."
    printf '  %-26s %s\n' ""              "update applies same-line moves; a MAJOR is reported, never applied."

    printf '\n%sMAJOR DATABASE UPGRADES%s  %s(deliberate, one at a time)%s\n' "$CG" "$C0" "$CD" "$C0"
    printf '  %-26s %s\n' "upgrade-postgres [TAG]" "Postgres MAJOR: dump -> preserve the old volume -> restore into"
    printf '  %-26s %s\n' ""              "the new version -> verify the table count matches -> health-gate."
    printf '  %-26s %s\n' ""              "Aborts if the counts differ. The old volume is KEPT until you"
    printf '  %-26s %s\n' ""              "delete it. Stack is down for a few minutes."
    printf '  %-26s %s\n' "upgrade-mongo [TAG]" "MongoDB MAJOR: dump -> step featureCompatibilityVersion down ->"
    printf '  %-26s %s\n' ""              "swap the image -> step FCV up -> verify collection counts."
    printf '  %-26s %s\n' ""              "Majors must be taken one at a time and cannot be downgraded"
    printf '  %-26s %s\n' ""              "once the FCV is raised. Only mongodb restarts."

    printf '\n%sDATA%s\n' "$CG" "$C0"
    printf '  %-26s %s\n' "backup"        "Snapshot Postgres + MongoDB + OpenSearch into ./backups/<timestamp>/."
    printf '  %-26s %s\n' ""              "OpenSearch is taken cold (stopped, tarred, started) - a hot tar of a"
    printf '  %-26s %s\n' ""              "live index restores to something that may not open."
    printf '  %-26s %s\n' "restore <dir>" "Restore all three from a backup dir (prompts, 5s abort)."

    printf '\n%sMAINTENANCE & SETUP%s\n' "$CG" "$C0"
    printf '  %-26s %s\n' "restart [svc]" "Restart one service, or the whole stack if none given."
    printf '  %-26s %s\n' "secret admin-password" "Print the first-boot admin password (from the manager log)."
    printf '  %-26s %s\n' "sso-cert url <jwks-url>" "Point SSO at the SIEM's JWKS endpoint (SIEM_JWKS_URL)."
    printf '  %-26s %s\n' "sso-cert check" "Show the SSO trust anchor and fetch the SIEM's JWKS the way the"
    printf '  %-26s %s\n' ""              "manager does — the one check that proves SSO can verify tokens."
    printf '  %-26s %s\n' "sso-cert fetch <host:port>" "Retrieve the certificate the SIEM presents, show its"
    printf '  %-26s %s\n' ""              "fingerprint to confirm, then install it. Use this on a new server."
    printf '  %-26s %s\n' "sso-cert install <file|->" "Install a certificate you were given (or pipe it in),"
    printf '  %-26s %s\n' ""              "set SIEM_JWKS_CA_BUNDLE, recreate the manager and verify."
    printf '  %-26s %s\n' "self-update"   "Fetch the newest csdlp from the repository. The compose file is"
    printf '  %-26s %s\n' ""              "fetched alongside as <compose>.new and NEVER overwritten - a major"
    printf '  %-26s %s\n' ""              "upgrade rewrites it, and the repo copy would undo that."
    printf '  %-26s %s\n' "self-install"  "Copy this script to /usr/local/bin/csdlp so \`csdlp\` runs anywhere."
    printf '  %-26s %s\n' ""              "A normal install already symlinks it; this is for unusual layouts."
    printf '  %-26s %s\n' "help"          "Show this guide."

    printf '\n%sENVIRONMENT%s\n' "$CG" "$C0"
    printf '  %-26s %s\n' "CSDLP_DIR"     "Deployment directory to operate on (else auto-detected:"
    printf '  %-26s %s\n' ""              "cwd, /opt/cybersentineldlp, /srv/cybersentineldlp)."
    printf '  %-26s %s\n' "CSDLP_COMPOSE" "Force a specific compose file (default: docker-compose.prod.yml)."

    printf '\n%sEXAMPLES%s\n' "$CG" "$C0"
    printf '  %s\n' "csdlp status                 # is everything healthy right now?"
    printf '  %s\n' "csdlp doctor --bundle        # collect a diagnostics file to send to the vendor"
    printf '  %s\n' "csdlp logs manager -f        # watch the backend live"
    printf '  %s\n' "csdlp update                 # roll forward to the latest images, safely"
    printf '  %s\n' "csdlp update 2.2.0           # roll forward to a specific version"
    printf '  %s\n' "csdlp update sha-a1b2c3d     # roll forward/back to one exact CI build"
    printf '  %s\n' "csdlp rollback               # undo the last update (and pin the good build)"
    printf '  %s\n' "csdlp check-updates          # what is behind upstream? changes nothing"
    printf '  %s\n' "csdlp upgrade-postgres       # Postgres major, with verification and a kept volume"
    printf '  %s\n' "csdlp update latest          # release a pin and return to the latest images"
    printf '  %s\n' "csdlp sso-cert fetch 10.200.10.23:3000   # trust a self-signed SIEM for SSO"
    printf '  %s\n' "csdlp sso-cert check         # can the manager verify SSO tokens right now?"
    printf '\n%sSafety:%s update always backs up first and self-heals on failure; doctor redacts\n' "$CD" "$C0"
    printf 'secrets; no command prints a password except `secret admin-password`.\n'
}

case "${1:-}" in
    status)   shift; cmd_status "$@";;
    ps)       shift; cmd_ps "$@";;
    logs)     shift; cmd_logs "$@";;
    update)   shift; cmd_update "$@";;
    rollback) shift; cmd_rollback "$@";;
    backup)   shift; cmd_backup "$@";;
    restore)  shift; cmd_restore "$@";;
    migrate)  shift; cmd_migrate "$@";;
    restart)  shift; cmd_restart "$@";;
    secret)   shift; cmd_secret "$@";;
    version)  shift; cmd_version "$@";;
    doctor)   shift; cmd_doctor "$@";;
    check-updates|check) shift; cmd_check_updates "$@";;
    upgrade-postgres)    shift; cmd_upgrade_postgres "$@";;
    upgrade-mongo)       shift; cmd_upgrade_mongo "$@";;
