  {
    "name": "Alert on Sensitive Clipboard Copy",
    "description": "Alerts when clipboard content classifies as sensitive (cards, SSN, Aadhaar, PAN, keys, DB connection strings). Enables the agent's clipboard channel (hasClipboardPolicies=true); action is alert, not block, so it never interferes with normal copy/paste.",
    "enabled": true,
    "priority": 70,
    "type": "clipboard_monitoring",
    "severity": "high",
    "config": {
      "patterns": {
        "predefined": [
          "ssn",
          "email",
          "credit_card",
          "phone",
          "api_key",
          "private_key",
          "aadhaar",
          "pan",
          "ifsc",
          "indian_bank_account",
          "indian_phone",
          "upi_id",
          "micr",
          "indian_dob",
          "source_code_content",
          "api_key_in_code",
          "database_connection_string"
        ],
        "custom": []
      },
      "action": "alert",
      "monitoredEvents": [
        "clipboard_copy"
      ],
      "contentTypes": [
        "text"
      ],
      "dataTypes": [
        "CREDIT_CARD",
        "SSN",
        "AADHAAR",
        "PAN_CARD",
        "EMAIL",
        "PHONE",
        "API_KEY",
        "PRIVATE_KEY",
        "AWS_KEY",
        "DATABASE_CONNECTION"
      ],
      "minMatchCount": 1
    },
    "conditions": {
      "match": "any",
      "rules": [
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{3}-\\d{2}-\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{3}[-.]?\\d{3}[-.]?\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b[A-Za-z0-9_-]{32,}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "-----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----"
        }
      ]
    },
    "actions": {
      "alert": {}
    }
  },
  {
    "name": "Block High-Confidence Sensitive USB Transfers",
    "description": "Blocks USB transfers of content classified Confidential/Restricted with high confidence. REQUIRES a blocking classification_level, not just a score: score alone fires on ordinary documents (a contact sheet of 3 emails once scored 0.84 while correctly classifying Internal). The level is the decision; the score only grades our confidence in it.",
    "enabled": true,
    "priority": 80,
    "type": "usb_file_transfer_monitoring",
    "severity": "high",
    "config": {
      "description": "Block USB transfers with high classification confidence regardless of level"
    },
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "classification_level",
          "operator": "in",
          "value": [
            "Confidential",
            "Restricted"
          ]
        },
        {
          "field": "confidence_score",
          "operator": ">=",
          "value": 0.8
        },
        {
          "field": "destination_type",
          "operator": "equals",
          "value": "removable_drive"
        }
      ]
    },
    "actions": {
      "block": {},
      "alert": {
        "severity": "high"
      }
    }
  },
