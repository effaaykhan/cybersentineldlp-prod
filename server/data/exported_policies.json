  {
    "name": "Monitor Sensitive Files (customize paths)",
    "description": "Watches a folder for sensitive files being created/modified and alerts. Enables the agent's file_system channel (hasFilePolicies=true). NOTE: the monitoredPaths below is a safe, universal Windows default — EDIT it to the folders your users actually stage data in (e.g. their Desktop/Downloads) for real coverage. Action is alert, not block.",
    "enabled": true,
    "priority": 40,
    "type": "file_system_monitoring",
    "severity": "medium",
    "config": {
      "monitoredPaths": [
        "C:\\Users\\Public\\Documents"
      ],
      "events": {
        "create": true,
        "modify": true,
        "delete": false,
        "move": true
      },
      "patterns": {
        "predefined": [
          "credit_card",
          "ssn",
          "aadhaar",
          "pan",
          "api_key",
          "private_key",
          "aws_key",
          "database_connection_string"
        ],
        "custom": []
      },
      "action": "alert",
      "fileExtensions": [
        ".txt",
        ".pdf",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".csv"
      ]
    },
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "file_path",
          "operator": "starts_with",
          "value": "C:\\Users\\Public\\Documents"
        }
      ]
    },
    "actions": {
      "alert": {
        "severity": "medium"
      }
    }
  },
