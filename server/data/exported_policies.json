[
  {
    "name": "Network Exfiltration MacOS",
    "description": "Watches outbound bulk-transfer processes (scp/sftp/curl/wget/rsync/netcat/cloud CLIs/smbclient). monitoredMethods is omitted on purpose: the agent treats that as all methods. Browser uploads are NOT visible to this channel. Alert, not block.",
    "enabled": true,
    "priority": 95,
    "type": "network_exfiltration_prevention",
    "severity": "high",
    "config": {
      "patterns": {
        "predefined": [
          "credit_card",
          "ssn",
          "aadhaar",
          "pan",
          "api_key",
          "private_key",
          "aws_key",
          "database_connection_string",
          "api_key_in_code",
          "source_code_content"
        ],
        "custom": []
      },
      "action": "alert"
    },
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "event_type",
          "operator": "in",
          "value": [
            "network_exfil",
            "network_transfer",
            "network_upload"
          ]
        }
      ]
    },
    "actions": {
      "alert": {}
    }
  },
  {
    "name": "Log All Clipboard Activity",
    "description": "Log all clipboard activity for audit purposes",
    "enabled": false,
    "priority": 100,
    "type": "clipboard_monitoring",
    "severity": "low",
    "config": {
      "patterns": {
        "predefined": [
          "ssn",
          "credit_card",
          "email",
          "phone",
          "api_key",
          "private_key",
          "pan",
          "ifsc",
          "indian_bank_account",
          "indian_phone",
          "upi_id",
          "micr",
          "indian_dob",
          "source_code_content",
          "api_key_in_code",
          "database_connection_string",
          "aadhaar"
        ],
        "custom": []
      },
      "action": "alert"
    },
    "conditions": {
      "match": "any",
      "rules": [
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{3}-\\d{2}-\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{3}[-.]?\\d{3}[-.]?\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b[A-Za-z0-9_-]{32,}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "-----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----"
        }
      ]
    },
    "actions": {
      "alert": {}
    }
  },
  {
    "name": "Messaging App Attachment Control",
    "description": "Alert on sensitive files attached in Teams/WhatsApp/Telegram/Slack/Discord/Signal. Endpoint inspects the file before the app encrypts it (alert-first; flip action to block to terminate the app on a sensitive attachment).",
    "enabled": true,
    "priority": 100,
    "type": "messaging_app_control",
    "severity": "high",
    "config": {
      "action": "block",
      "apps": [
        "teams.exe",
        "ms-teams.exe",
        "msteams.exe",
        "whatsapp.exe",
        "telegram.exe",
        "slack.exe",
        "discord.exe",
        "signal.exe",
        "WhatsApp.root.exe"
      ],
      "exceptions": {
        "users": [],
        "file_types": []
      },
      "inspect_messages": true
    },
    "conditions": {
      "match": "all",
      "rules": []
    },
    "actions": {
      "log": {}
    }
  },
  {
    "name": "USB File Transfer MacOS",
    "description": "Classifies files copied to removable media on macOS. Scoped by agent_ids to Macs; action is alert, not block.",
    "enabled": true,
    "priority": 100,
    "type": "usb_file_transfer_monitoring",
    "severity": "high",
    "config": {
      "patterns": {
        "predefined": [
          "credit_card",
          "ssn",
          "aadhaar",
          "pan",
          "api_key",
          "private_key",
          "aws_key",
          "database_connection_string",
          "api_key_in_code",
          "source_code_content"
        ],
        "custom": []
      },
      "action": "alert"
    },
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "destination_type",
          "operator": "equals",
          "value": "removable_drive"
        }
      ]
    },
    "actions": {
      "alert": {}
    }
  },
  {
    "name": "Web Activity Control",
    "description": "",
    "enabled": true,
    "priority": 100,
    "type": "web_activity_control",
    "severity": "high",
    "config": {
      "mode": "enforce",
      "minLevel": "Confidential",
      "matrix": {
        "webmail": {
          "upload": "block",
          "download": "block",
          "attach": "block",
          "send": "block"
        },
        "cloud_storage": {
          "upload": "block",
          "download": "block",
          "post": "mask"
        },
        "collaboration": {
          "upload": "block",
          "download": "block",
          "post": "mask"
        },
        "genai": {
          "upload": "block",
          "download": "block",
          "attach": "block",
          "post": "mask",
          "ai_response": "block"
        }
      },
      "appOverrides": [],
      "blockUninspectable": true,
      "action": "block"
    },
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "event_type",
          "operator": "in",
          "value": [
            "cloud_upload",
            "collaboration",
            "email",
            "genai"
          ]
        },
        {
          "field": "activity",
          "operator": "in",
          "value": [
            "ai_response",
            "attach",
            "download",
            "post",
            "send",
            "upload"
          ]
        },
        {
          "field": "classification_level",
          "operator": "in",
          "value": [
            "Confidential",
            "Restricted"
          ]
        }
      ]
    },
    "actions": {
      "log": {}
    }
  },
