[
  {
    "name": "Block Uninspectable Content (all channels)",
    "description": "Block content we cannot inspect — password-protected archives, scanned images, opaque binaries, and files over the inspection cap. Uninspectable is not the same as clean: without this, padding a file past the cap or putting a password on a zip bypasses DLP entirely.",
    "enabled": true,
    "priority": 5,
    "type": "classification_aware_policy",
    "severity": "high",
    "config": {},
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "event_type",
          "operator": "in",
          "value": [
            "usb_file_transfer",
            "file_transfer",
            "email_send",
            "cloud_upload"
          ]
        },
        {
          "field": "extraction_status",
          "operator": "in",
          "value": [
            "unreadable",
            "too_large"
          ]
        }
      ]
    },
    "actions": {
      "block": {},
      "alert": {
        "severity": "high",
        "message": "Uninspectable file blocked"
      }
    }
  },
  {
    "name": "Block Oversized Uninspected Files",
    "description": "Blocks files too large to inspect (over the agent's 25MB cap, or whose text outran the scan budget). This closes the padding bypass: without it, padding a secret past the cap makes it skip inspection entirely and pass. TRADE-OFF: this also blocks large legitimate files such as videos and disk images, which are genuinely uninspectable. If big-file workflows matter more than that bypass, change this policy's action from block to alert — it is intentionally separate from 'Block Uninspectable Content' so you can tune the two independently.",
    "enabled": true,
    "priority": 6,
    "type": "classification_aware_policy",
    "severity": "high",
    "config": {
      "description": "Refuse files that were never inspected because they were too large"
    },
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "event_type",
          "operator": "in",
          "value": [
            "usb_file_transfer",
            "file_transfer",
            "email_send",
            "cloud_upload"
          ]
        },
        {
          "field": "extraction_status",
          "operator": "equals",
          "value": "too_large"
        }
      ]
    },
    "actions": {
      "block": {},
      "alert": {
        "severity": "high",
        "message": "Oversized uninspected file blocked"
      }
    }
  },
