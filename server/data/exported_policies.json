[
  {
    "name": "Log All Clipboard Activity",
    "description": "Log all clipboard activity for audit purposes",
    "enabled": false,
    "priority": 100,
    "type": "clipboard_monitoring",
    "severity": "low",
    "config": {
      "patterns": {
        "predefined": [
          "ssn",
          "credit_card",
          "email",
          "phone",
          "api_key",
          "private_key",
          "pan",
          "ifsc",
          "indian_bank_account",
          "indian_phone",
          "upi_id",
          "micr",
          "indian_dob",
          "source_code_content",
          "api_key_in_code",
          "database_connection_string",
          "aadhaar"
        ],
        "custom": []
      },
      "action": "alert"
    },
    "conditions": {
      "match": "any",
      "rules": [
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{3}-\\d{2}-\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}[\\s-]?\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b\\d{3}[-.]?\\d{3}[-.]?\\d{4}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "\\b[A-Za-z0-9_-]{32,}\\b"
        },
        {
          "field": "clipboard_content",
          "operator": "matches_regex",
          "value": "-----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----"
        }
      ]
    },
    "actions": {
      "alert": {}
    }
  },
  {
    "name": "application control policy",
    "description": "",
    "enabled": false,
    "priority": 100,
    "type": "application_control",
    "severity": "medium",
    "config": {
      "mode": "allowlist",
      "applications": [],
      "channels": [],
      "exceptions": {
        "applications": []
      }
    },
    "conditions": {
      "match": "all",
      "rules": []
    },
    "actions": {
      "log": {}
    }
  },
  {
    "name": "File Monitoring MacOS",
    "description": "Watches the folders macOS users actually stage data in. Paths use ~ so they resolve per-user on any Mac (the agent expands them via expanduser; glob patterns like /Users/*/Documents are NOT supported and are silently rejected). Scoped by agent_ids to macOS endpoints only — add the agent_id of any newly enrolled Mac. Action is alert, not block.",
    "enabled": true,
    "priority": 110,
    "type": "file_system_monitoring",
    "severity": "medium",
    "config": {
      "monitoredPaths": [
        "~/Documents",
        "~/Desktop",
        "~/Downloads"
      ],
      "events": {
        "create": true,
        "modify": true,
        "delete": false,
        "move": true
      },
      "patterns": {
        "predefined": [
          "credit_card",
          "ssn",
          "aadhaar",
          "pan",
          "api_key",
          "private_key",
          "aws_key",
          "database_connection_string",
          "api_key_in_code",
          "source_code_content"
        ],
        "custom": []
      },
      "action": "alert",
      "fileExtensions": [
        ".txt",
        ".pdf",
        ".doc",
        ".docx",
        ".xls",
        ".xlsx",
        ".csv",
        ".json",
        ".env",
        ".pem",
        ".key"
      ]
    },
    "conditions": {
      "match": "all",
      "rules": [
        {
          "field": "file_path",
          "operator": "matches_any_prefix",
          "value": [
            "~/Documents",
            "~/Desktop",
            "~/Downloads"
          ]
        },
        {
          "field": "event_subtype",
          "operator": "in",
          "value": [
            "file_created",
            "file_modified",
            "file_moved"
          ]
        },
        {
          "field": "file_extension",
          "operator": "in",
          "value": [
            ".txt",
            ".pdf",
            ".doc",
            ".docx",
            ".xls",
            ".xlsx",
            ".csv",
            ".json",
            ".env",
            ".pem",
            ".key"
          ]
        }
      ]
    },
    "actions": {
      "alert": {}
    }
  },
